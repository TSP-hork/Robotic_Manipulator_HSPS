// --- CLOCK GENERATOR ---
IO_LOC "clk" 52;
IO_PORT "clk" PULL_MODE=UP;

// --- RESET BUTTON (S1 on TANG NANO) ---
IO_LOC "btn1" 3;
IO_PORT "btn1" PULL_MODE=UP;

// --- LEDS OUTPUTS ---
IO_LOC "led[0]" 10;
IO_PORT "led[0]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC "led[1]" 11;
IO_PORT "led[1]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC "led[2]" 13;
IO_PORT "led[2]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC "led[3]" 14;
IO_PORT "led[3]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC "led[4]" 15;
IO_PORT "led[4]" DRIVE=8 IO_TYPE=LVCMOS18;

IO_LOC "led[5]" 16;
IO_PORT "led[5]" DRIVE=8 IO_TYPE=LVCMOS18;

// --- ENCODERS INPUTS ---

// Pin 25 -> Encoder A (Black)
IO_LOC "enc_a" 25;
IO_PORT "enc_a" PULL_MODE=UP IO_TYPE=LVCMOS33;

// Pin 26 -> Encoder B (White)
IO_LOC "enc_b" 26;
IO_PORT "enc_b" PULL_MODE=UP IO_TYPE=LVCMOS33;